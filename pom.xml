<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.akka</groupId>
        <artifactId>akka-javasdk-parent</artifactId>
        <version>3.6.2</version>
    </parent>
    <groupId>io.akk</groupId>
    <artifactId>mcp-gateway</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>mcp-gateway</name>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <!-- Set dockerImage/dockerRegistry to your own container registry before deploying. -->
        <dockerImage>mcp-gateway</dockerImage>
        <docker.tag>${git.commit.id.abbrev}</docker.tag>
        <!-- Every ${?VAR} in application.conf. Excluded from test JVMs so a developer's exported config cannot override test config. -->
        <test.excludedEnvironmentVariables>AKKA_SALESFORCE_MCP_URL,AKKA_SALESFORCE_OKTA_APP_ID,ANTHROPIC_API_KEY,GMAIL_CLIENT_ID,GMAIL_CLIENT_SECRET,GMAIL_MCP_URL,GMAIL_OKTA_APP_ID,GMAIL_REDIRECT_URI,GOOGLE_CALENDAR_CLIENT_ID,GOOGLE_CALENDAR_CLIENT_SECRET,GOOGLE_CALENDAR_MCP_URL,GOOGLE_CALENDAR_OKTA_APP_ID,GOOGLE_CALENDAR_REDIRECT_URI,GOOGLE_DRIVE_CLIENT_ID,GOOGLE_DRIVE_CLIENT_SECRET,GOOGLE_DRIVE_MCP_URL,GOOGLE_DRIVE_OKTA_APP_ID,GOOGLE_DRIVE_REDIRECT_URI,GOOGLE_WORKSPACE_CALENDAR_MCP_URL,GOOGLE_WORKSPACE_CLIENT_ID,GOOGLE_WORKSPACE_CLIENT_SECRET,GOOGLE_WORKSPACE_DOCS_MCP_URL,GOOGLE_WORKSPACE_DRIVE_MCP_URL,GOOGLE_WORKSPACE_GMAIL_MCP_URL,GOOGLE_WORKSPACE_OKTA_APP_ID,GOOGLE_WORKSPACE_REDIRECT_URI,GOOGLE_WORKSPACE_SHEETS_MCP_URL,GROUNDCOVER_MCP_URL,GROUNDCOVER_OKTA_APP_ID,GROUNDCOVER_REDIRECT_URI,HUBSPOT_CLIENT_ID,HUBSPOT_CLIENT_SECRET,HUBSPOT_MCP_URL,HUBSPOT_OKTA_APP_ID,HUBSPOT_REDIRECT_URI,MCP_BASE_URL,MCP_OAUTH_REDIRECT_HOST_ALLOWLIST,MCP_PROXY_OKTA_API_TOKEN,OKTA_ADMIN_MCP_URL,OKTA_ADMIN_OKTA_APP_ID,OKTA_ALLOWED_EMAIL_DOMAIN,OKTA_CLIENT_ID,OKTA_CLIENT_SECRET,OKTA_GROUP_ADMIN,OKTA_GROUP_ESCALATER,OKTA_GROUP_READER,OKTA_GROUP_WRITER,OKTA_ISSUER_URL,OKTA_JWKS_URI,OKTA_REDIRECT_URI,REO_MCP_URL,REO_OKTA_APP_ID,REO_REDIRECT_URI,SALESFORCE_CLIENT_ID,SALESFORCE_CLIENT_SECRET,SALESFORCE_MCP_URL,SALESFORCE_OAUTH_LOGIN_URL,SALESFORCE_OKTA_APP_ID,SALESFORCE_REDIRECT_URI,SEAMLESS_API_KEY,SEAMLESS_MCP_URL,SEAMLESS_OKTA_APP_ID,SLACK_CLIENT_ID,SLACK_CLIENT_SECRET,SLACK_MCP_URL,SLACK_OKTA_APP_ID,SLACK_REDIRECT_URI,SUPPORT_EMAIL,SUPPORT_SLACK_CHANNEL,ZOHO_MCP_URL,ZOHO_OKTA_APP_ID,ZOHO_REDIRECT_URI</test.excludedEnvironmentVariables>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>pl.project13.maven</groupId>
                <artifactId>git-commit-id-plugin</artifactId>
                <version>4.9.10</version>
                <executions>
                    <execution>
                        <id>get-git-info</id>
                        <goals><goal>revision</goal></goals>
                        <phase>initialize</phase>
                    </execution>
                </executions>
                <configuration>
                    <shortAbbrevLength>8</shortAbbrevLength>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <goals><goal>check</goal></goals>
                        <phase>validate</phase>
                    </execution>
                </executions>
                <configuration>
                    <configLocation>checkstyle/checkstyle.xml</configLocation>
                    <violationSeverity>warning</violationSeverity>
                    <failOnViolation>true</failOnViolation>
                    <failsOnError>true</failsOnError>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <excludedEnvironmentVariables>${test.excludedEnvironmentVariables}</excludedEnvironmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <excludedEnvironmentVariables>${test.excludedEnvironmentVariables}</excludedEnvironmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>9.40</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-mcp</artifactId>
            <version>1.15.0-beta25</version>
        </dependency>
    </dependencies>
</project>
