<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Shared ruleset for all Maven projects in this repo (root pom.xml and each
  mcp-servers/*/pom.xml).

  Deliberately NOT a stock Google/Sun ruleset: this codebase has an established,
  intentional style (single-line getters/validation, braceless one-line ifs,
  lowercase static-final service handles like `log`/`okta` alongside
  SCREAMING_CASE for literal constants, no mandatory Javadoc per AGENTS.md's
  "no comments unless the WHY is non-obvious"), so checks that would fight
  that style (NeedBraces, LeftCurly, ConstantName) are left out.
  Test sources are excluded (see includeTestSourceDirectory=false in each pom) —
  test method names here use the widely-accepted methodUnderTest_condition_result
  underscore convention, which plain MethodName can't express.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>

    <!-- Size -->
    <module name="LineLength">
        <property name="max" value="160"/>
        <property name="ignorePattern" value="^import\s.*$|^\s*\*.*$"/>
    </module>

    <module name="TreeWalker">
        <!-- Imports -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="AvoidStarImport"/>
        <module name="RegexpSinglelineJava">
            <property name="format" value="^import io\.akka\.javasdk\."/>
            <property name="message" value="Use akka.javasdk.* imports, not io.akka.javasdk.* (see AGENTS.md)."/>
        </module>

        <!-- Whitespace / braces -->
        <module name="RightCurly"/>
        <module name="WhitespaceAfter"/>
        <module name="GenericWhitespace"/>

        <!-- Naming -->
        <module name="ClassTypeParameterName"/>
        <module name="MethodTypeParameterName"/>
        <module name="PackageName"/>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>

        <!-- Coding -->
        <module name="EqualsHashCode"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="UnusedLocalVariable"/>
    </module>
</module>
